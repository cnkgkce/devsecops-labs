GEMINI_API_KEY=AIzaSy_BURAYA_GERCEK_API_KEY_YAZILACAK

# LiteLLM Proxy Master Key (Yerel kimlik doğrulama için)
LITELLM_MASTER_KEY=sk-devsecops-litellm-123456
